# Local MongoDB. This value is read only by the backend, never by Vite.
MONGODB_URI=mongodb://127.0.0.1:27017/notehub
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# Use a random value of at least 32 characters; keep .env private.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-before-starting
